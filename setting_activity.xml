<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/main_bg"
    android:gravity="center_horizontal"
    android:padding="16dp"
    tools:context=".SettingsActivity">

    <!-- Home Icon -->
    <ImageView
        android:id="@+id/home_icon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="27dp"
        android:contentDescription="@string/home_icon"
        android:src="@drawable/home_icon"
        android:layout_gravity="start" />

    <!-- Settings Text -->
    <TextView
        android:id="@+id/tv_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/righteous"
        android:text="@string/setting_icon"
        android:textColor="@color/white"
        android:textSize="50sp" />

    <!-- Music Setting (Group RadioButtons in RadioGroup) -->
    <LinearLayout
        android:id="@+id/ll_settings1"
        android:layout_width="350dp"
        android:layout_height="90dp"
        android:layout_marginTop="50dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="5"
            android:fontFamily="@font/righteous"
            android:textColor="@color/white"
            android:text="@string/settings_music"
            android:textSize="30sp" />

        <!-- Add RadioGroup for accessibility -->
        <RadioGroup
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical">

            <RadioButton
                android:id="@+id/on_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music_on"
                android:fontFamily="@font/righteous"
                android:textColor="@color/white"
                android:contentDescription="@string/on_music"
                android:textSize="30sp"
                android:minHeight="48dp"
                android:minWidth="48dp" />

            <RadioButton
                android:id="@+id/off_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music_off"
                android:fontFamily="@font/righteous"
                android:textColor="@color/white"
                android:contentDescription="@string/off_music"
                android:textSize="30sp"
                android:minHeight="48dp"
                android:minWidth="48dp" />
        </RadioGroup>
    </LinearLayout>

    <!-- Sound Setting (Group RadioButtons in RadioGroup) -->
    <LinearLayout
        android:id="@+id/ll_settings2"
        android:layout_width="350dp"
        android:layout_height="90dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_sound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/righteous"
            android:textColor="@color/white"
            android:text="@string/settings_sounds"
            android:textSize="30sp" />

        <!-- Add RadioGroup for accessibility -->
        <RadioGroup
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical">

            <RadioButton
                android:id="@+id/on_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music_on"
                android:fontFamily="@font/righteous"
                android:textColor="@color/white"
                android:contentDescription="@string/on_sound"
                android:textSize="30sp"
                android:minHeight="48dp"
                android:minWidth="48dp" />

            <RadioButton
                android:id="@+id/off_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music_off"
                android:fontFamily="@font/righteous"
                android:textColor="@color/white"
                android:contentDescription="@string/off_sound"
                android:textSize="30sp"
                android:minHeight="48dp"
                android:minWidth="48dp" />
        </RadioGroup>
    </LinearLayout>

</LinearLayout>
